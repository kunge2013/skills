# 日志配置
# 日志级别: debug, info, warn, error, silent
LOG_LEVEL=info

# 只显示特定模块的日志（可选，逗号分隔）
# 例如: LOG_MODULES=pi-sdk,agent
# LOG_MODULES=

# 服务器端口
PORT=3000

# 数据目录（可选）
# DATA_DIR=./data

# API 密码（可选）
# API_PASSWORD=your_password

# 模型 API Keys
# OPENAI_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx
# DEEPSEEK_API_KEY=sk-xxx
